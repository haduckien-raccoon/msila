+++ b/configs/full_scale_synthetic.yaml
@@ -0,0 +1,25 @@
+version: native_tiny_proxy_v2
+locked_before_evaluation: true
+basis: synthetic_proxy_no_real_defect_calibration
+area_unit: native_pixels
+connectivity: 8
+rationale: >-
+  Proxy bins declared before evaluating models. 4-32 pixels probe sub-patch
+  defects; 33-128 pixels probe small regions within a 16x16 DINO patch;
+  129-2048 pixels provide a mixed-size control. These are foreground areas,
+  not bounding-box areas and not a fitted distribution of real TEST defects.
+size_bins:
+  sub_patch: [4, 32]
+  small: [33, 128]
