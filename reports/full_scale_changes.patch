+            self.patch_size=spec.patch_size
+            self.p=nn.Parameter(torch.ones(1))
+        def get_intermediate_layers(self,x,*,n,**kwargs):
+            return tuple(torch.full((x.shape[0],self.embed_dim,x.shape[-2]//16,x.shape[-1]//16),float(b)) for b in n)
+    model=MockDino()
